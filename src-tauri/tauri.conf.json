{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LazyKeys",
  "version": "0.1.0",
  "identifier": "com.lazykeys.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LazyKeys",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "copyright": "Copyright © 2026 0H (12bitsD)",
    "category": "DeveloperTool",
    "shortDescription": "LazyVim command companion for macOS",
    "resources": {
      "../companion/lazykeys.nvim": "lazykeys.nvim"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
